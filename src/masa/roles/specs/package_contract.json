{
  "id": "package_contract",
  "label": "包间契约作者",
  "description": "多包项目：在写代码之前，把包与包之间的导出签名和跨包规则写成结构化契约（默认关闭）",
  "order": 130,
  "level": "top",
  "optional": true,
  "routable": false,
  "config_allowed": true,
  "permissions": {
    "reads": [
      "goal",
      "spec"
    ],
    "writes": "none"
  },
  "validator": "json_schema",
  "prompt": "package_contract.prompt.md",
  "max_output_tokens": 3000,
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "packages",
      "rules"
    ],
    "properties": {
      "packages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dir",
            "exports"
          ],
          "properties": {
            "dir": {
              "type": "string",
              "maxLength": 120
            },
            "exports": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "signature"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "signature": {
                    "type": "string",
                    "maxLength": 240
                  }
                }
              }
            }
          }
        }
      },
      "rules": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
