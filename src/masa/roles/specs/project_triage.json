{
  "id": "project_triage",
  "label": "可行性初筛",
  "description": "判断需求能否在 Go 标准库命令行项目下自动验证（只告警，只用本地模型）",
  "order": 70,
  "level": null,
  "routable": false,
  "config_allowed": true,
  "permissions": {
    "reads": [
      "goal"
    ],
    "writes": "none"
  },
  "validator": "triage",
  "prompt": "project_triage.prompt.md",
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "verdict",
      "reasons",
      "suggestions"
    ],
    "properties": {
      "verdict": {
        "enum": [
          "ok",
          "risky"
        ]
      },
      "reasons": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "string",
          "maxLength": 400
        }
      },
      "suggestions": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "string",
          "maxLength": 400
        }
      }
    }
  }
}
