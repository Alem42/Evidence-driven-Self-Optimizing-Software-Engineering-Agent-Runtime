{
  "id": "package_worker",
  "label": "包工人",
  "description": "Runtime V2：负责一个包的自主循环——写实现与测试、跑真实检查、读错误、修改，直到本包通过（实验功能，只在 runtime=v2 时使用）",
  "order": 120,
  "level": "low",
  "optional": true,
  "routable": false,
  "config_allowed": false,
  "permissions": {
    "reads": [
      "goal",
      "acceptance",
      "examples",
      "own_files",
      "interfaces",
      "last_results"
    ],
    "writes": "implementation"
  },
  "validator": "worker_action",
  "prompt": "package_worker.prompt.md",
  "max_output_tokens": 6000,
  "input": [
    "goal",
    "acceptance",
    "examples",
    "package",
    "own_files",
    "files",
    "interfaces",
    "last_results",
    "notes",
    "step",
    "max_steps",
    "language_notes",
    "spec_examples",
    "repair",
    "allowed_tools"
  ],
  "output_schema": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "path",
          "content"
        ],
        "properties": {
          "tool": {
            "const": "write_file"
          },
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "content": {
            "type": "string",
            "maxLength": 60000
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "path",
          "old",
          "new"
        ],
        "properties": {
          "tool": {
            "const": "edit_file"
          },
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "old": {
            "type": "string",
            "maxLength": 20000
          },
          "new": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "path"
        ],
        "properties": {
          "tool": {
            "const": "read_file"
          },
          "path": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "kind"
        ],
        "properties": {
          "tool": {
            "const": "run_check"
          },
          "kind": {
            "enum": [
              "test",
              "static"
            ]
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "text"
        ],
        "properties": {
          "tool": {
            "const": "note"
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool"
        ],
        "properties": {
          "tool": {
            "const": "finish"
          }
        }
      }
    ]
  }
}
