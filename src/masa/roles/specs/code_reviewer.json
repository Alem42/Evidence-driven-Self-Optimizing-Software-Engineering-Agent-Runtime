{
  "id": "code_reviewer",
  "label": "代码审阅者",
  "description": "只读：对已通过 Gate 但经过多轮修复的实现给出风险提示，只作建议，不影响裁决（指挥者开启时才运行）",
  "order": 100,
  "level": "top",
  "routable": true,
  "config_allowed": true,
  "permissions": {
    "reads": [
      "goal",
      "acceptance",
      "files"
    ],
    "writes": "none"
  },
  "validator": "json_schema",
  "prompt": "code_reviewer.prompt.md",
  "max_output_tokens": 1200,
  "when": {
    "guard": "repaired_before_pass"
  },
  "input": [
    "goal",
    "acceptance",
    "files"
  ],
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "risks",
      "summary"
    ],
    "properties": {
      "risks": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "risk",
            "severity"
          ],
          "properties": {
            "file": {
              "type": "string",
              "maxLength": 200
            },
            "risk": {
              "type": "string",
              "maxLength": 300
            },
            "severity": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        }
      },
      "summary": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
